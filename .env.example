# FC APG 1921 — environment variables (Vercel + Neon PostgreSQL)
# Copy the real values in the Vercel dashboard: Settings → Environment Variables.

# ── Database (Neon) — REQUIRED ────────────────────────────────
# Neon dashboard → Connection string (pooled, with sslmode=require)
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ── Site ──────────────────────────────────────────────────────
# Public origin, used for canonical URLs, sitemap, robots, llms.txt, OG images.
# No trailing slash. Example: https://www.fc-apg.ch
NEXT_PUBLIC_SITE_URL="https://www.example.ch"

# ── Admin panel (/admin) — REQUIRED ───────────────────────────
# Password of the content panel (choose a strong one).
ADMIN_PASSWORD="change-me"

# ── Analytics (optional) ──────────────────────────────────────
# GA4 measurement ID (gtag) and/or GTM container ID.
# Leave empty to load zero third-party scripts.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""

# ── WhatsApp (contact form opens a pre-filled chat) ───────────
# International format, digits only. Example: 41791234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
